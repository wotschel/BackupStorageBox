#!/bin/bash
#
# 90-nextcloud – post-backup hook for backup.sh
#
# Ends the Nextcloud maintenance mode after every backup, also a failed one –
# regardless of whether it was already on before.
#
# Installation directory, user and PHP binary come from the state file the
# pre hook writes, so nothing has to be detected again.
#
set -euo pipefail

STATE_FILE="${NEXTCLOUD_STATE_FILE:-/var/lib/backup/nextcloud.state}"

say() { echo "Nextcloud: $*"; }
die() { echo "Nextcloud: ERROR: $*" >&2; exit 1; }

if [[ ! -f $STATE_FILE ]]; then
    say "nothing to do (the pre hook did not detect Nextcloud)."
    exit 0
fi

NEXTCLOUD_DIR="" NC_USER="" NC_PHP=""
while IFS='=' read -r key value; do
    case $key in
        NEXTCLOUD_DIR) NEXTCLOUD_DIR="$value" ;;
        NC_USER)       NC_USER="$value" ;;
        NC_PHP)        NC_PHP="$value" ;;
    esac
done < "$STATE_FILE"

[[ -f $NEXTCLOUD_DIR/occ && -n $NC_USER && -x $NC_PHP ]] \
    || die "invalid state file $STATE_FILE – end the maintenance mode manually: occ maintenance:mode --off"

occ() {
    local -a cmd=("$NC_PHP" -d apc.enable_cli=1 "$NEXTCLOUD_DIR/occ" --no-interaction "$@")
    if [[ $(id -un) == "$NC_USER" ]]; then
        (cd "$NEXTCLOUD_DIR" && "${cmd[@]}")
    else
        (cd "$NEXTCLOUD_DIR" && runuser -u "$NC_USER" -- "${cmd[@]}")
    fi
}

occ maintenance:mode --off >/dev/null \
    || die "could not end maintenance mode – Nextcloud is still offline! Run: occ maintenance:mode --off"

if [[ $(occ config:system:get maintenance 2>/dev/null || true) == true ]]; then
    die "maintenance mode is still on after --off – Nextcloud is still offline!"
fi
rm -f -- "$STATE_FILE"
say "maintenance mode off."
